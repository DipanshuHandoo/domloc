{
  "name": "@dipanshuhandoo/domloc",
  "version": "0.0.0",
  "description": "Readable, unique CSS selectors and absolute XPaths for browser DOM, jsdom and Cheerio (domhandler) nodes. One algorithm, zero dependencies.",
  "keywords": [
    "css-selector",
    "unique-selector",
    "selector-generator",
    "xpath",
    "cheerio",
    "domhandler",
    "jsdom",
    "dom",
    "playwright",
    "puppeteer",
    "scraping",
    "crawler"
  ],
  "license": "MIT",
  "author": "Dipanshu Handoo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DipanshuHandoo/domloc.git"
  },
  "homepage": "https://github.com/DipanshuHandoo/domloc#readme",
  "bugs": {
    "url": "https://github.com/DipanshuHandoo/domloc/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "lint": "node scripts/run.mjs --bin @biomejs/biome biome lint --error-on-warnings .",
    "format": "node scripts/run.mjs --bin @biomejs/biome biome format --write .",
    "format:check": "node scripts/run.mjs --bin @biomejs/biome biome format .",
    "typecheck": "node scripts/run.mjs --bin typescript tsc -p tsconfig.json --noEmit",
    "test:package": "node scripts/check-package.mjs",
    "verify": "node scripts/verify.mjs",
    "pack:check": "node scripts/check-package.mjs --pack-only",
    "publish:dry": "npm publish --dry-run --provenance=false",
    "release": "node scripts/release.mjs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only --ignore-scripts",
    "prepublishOnly": "node scripts/release.mjs --prepublish-guard",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.4",
    "@changesets/cli": "^3.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  },
  "unpkg": "./dist/browser/index.min.js",
  "jsdelivr": "./dist/browser/index.min.js"
}
